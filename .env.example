# Mentoria Conjunta - Variáveis de Ambiente
# Copie este arquivo para .env-dev.txt (DEV remoto) ou .env.local (PostgreSQL local)

NODE_ENV=development
PORT=5021
VITE_PORT=5020

# PostgreSQL
DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# Session
SESSION_SECRET=sua-chave-secreta-aqui

# MailerSend (envio de emails)
MAILERSEND_API_KEY=mlsn.sua-chave-aqui
