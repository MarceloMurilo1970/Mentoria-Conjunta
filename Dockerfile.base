# ========= IMAGEM BASE: node_modules pré-instalados =========
# Rebuild apenas quando package.json ou package-lock.json mudar
# Uso: ./deploy-ecs.sh --base-only

FROM node:20-slim

WORKDIR /app

# Dependências de sistema para pacotes nativos (bcrypt, pdfkit, etc.)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    python3 \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Copia manifestos
COPY package.json package-lock.json ./

# Instala TODAS as dependências (dev + prod)
RUN npm ci

# Instala prod-only em pasta separada para o runtime
RUN cp -r node_modules node_modules_all \
    && npm ci --omit=dev \
    && mv node_modules node_modules_prod \
    && mv node_modules_all node_modules
